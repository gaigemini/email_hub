# API Authentication
API_KEY=your-super-secret-api-key-change-this-in-production

# --- NEW: ENCRYPTION KEY ---
# Generate a new key by running this command in your terminal:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-url-safe-base64-encoded-key-goes-here

# Database Configuration
DATABASE_URL=sqlite:///./email_hub.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
# For MySQL: mysql+pymysql://user:password@localhost/dbname

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Email Polling Configuration
POLLING_INTERVAL_SECONDS=120
POLLING_CHECK_INTERVAL_SECONDS=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO
